# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# Supabase (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public-aqui

# Secreta — Project Settings -> API -> service_role. NUNCA prefixar com
# NEXT_PUBLIC_, nunca expor ao browser. Usada só pelas rotas de servidor em
# app/api/** (webhook do WhatsApp, envio de mensagem, etc.).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# String qualquer que você inventa e cola nos dois lados: aqui e no painel
# do Meta App (WhatsApp -> Configuration -> Webhook), usada só no handshake
# de verificação (GET /api/whatsapp/webhook).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=escolha-uma-string-secreta-aqui
